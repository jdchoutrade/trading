{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qra-gold-terminal",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/ws", "/health"]
  },
  "containers": [
    {
      "class_name": "QraBackend",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "QraBackend",
        "name": "BACKEND"
      }
    ]
  },
  "exports": {
    "QraBackend": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "qra-gold-terminal-backups"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
