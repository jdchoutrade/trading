# Copy this file to .env and replace the Neon URL with your pooled Neon connection string.
# Keep .env private; never commit it or paste the connection string into chat.
NODE_ENV=development
NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/DATABASE?sslmode=require"

# Keep localhost snapshots separate from the Cloudflare production snapshots.
NEON_SNAPSHOT_SCOPE=localhost
NEON_SNAPSHOT_INTERVAL_MS=300000

# Market and live scan settings
PRIMARY_SYMBOL=OANDA:XAUUSD
SIGNAL_TRIGGER_TF=15m
LIVE_SIGNAL_SCAN_INTERVAL_MS=750
LIVE_AI_REVIEW=true

# Optional integrations
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
TV_SESSION=
TV_SIGNATURE=
MARKETAUX_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
